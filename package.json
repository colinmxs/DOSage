{
  "name": "dosage",
  "version": "0.1.0",
  "description": "A TypeScript component library recreating DOS-era interfaces",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./css": "./dist/css/dosage.css",
    "./css/*": "./dist/css/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/types",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:landing": "vite build --config landing/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "mcp:install": "cd mcp-server && npm install",
    "mcp:build": "cd mcp-server && npm run build",
    "mcp:server": "node mcp-server/dist/index.js",
    "mcp:start": "npm run docs && npm run mcp:build && npm run mcp:server",
    "mcp:setup": "npm run docs && npm run mcp:install && npm run mcp:build",
    "prepublishOnly": "npm run build && npm run test",
    "version": "npm run build && git add -A",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "dos",
    "retro",
    "ui",
    "components",
    "typescript",
    "terminal",
    "ascii",
    "nostalgic",
    "vintage"
  ],
  "author": {
    "name": "colinmxs",
    "email": "the.sbmt.api@gmail.com",
    "url": "https://github.com/colinmxs/DOSage"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/colinmxs/DOSage.git"
  },
  "bugs": {
    "url": "https://github.com/colinmxs/DOSage/issues"
  },
  "homepage": "https://github.com/colinmxs/DOSage",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^1.0.0-pre.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
