{
  "name": "dosage",
  "version": "0.1.0",
  "description": "A TypeScript component library that recreates the aesthetic of classic DOS-era computer interfaces",
  "keywords": [
    "dos",
    "retro",
    "ui",
    "components",
    "typescript",
    "nostalgic"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:lib && npm run build:types && npm run build:styles",
    "build:clean": "rm -rf dist",
    "build:lib": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:types": "tsc --project tsconfig.types.json",
    "build:styles": "cp src/styles/*.css dist/",
    "dev": "npm run dev:kitchen-sink",
    "dev:kitchen-sink": "vite kitchen-sink --port 3000",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colinmxs/DOSage.git"
  },
  "author": "Colin Maxwell",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
